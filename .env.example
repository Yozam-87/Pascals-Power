# .env.example
# Copy this file, rename it to .env, and update the paths to match your system.
LLAMA_SERVER_PATH=./llama-server
MODELS_DIR=./models
PORT=5005
# Optional: pipe-separated KEY=VALUE pairs passed to the llama-server subprocess.
# Example: CUDA_VISIBLE_DEVICES=0|NCCL_DEBUG=INFO
# ENV_VARS=CUDA_VISIBLE_DEVICES=0